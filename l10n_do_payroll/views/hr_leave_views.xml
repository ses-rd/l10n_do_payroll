<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_inherit_l10n_do_payroll" model="ir.ui.view">
        <field name="name">hr.leave.form.inherit.l10n.do.payroll</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="vacation_payslip_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
            </xpath>
        </field>
    </record>
</odoo>