<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <!-- Inherit Form View to Modify it -->
    <record id="hr_payslip_run_form_view_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.view.inherit</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <!-- Insertar campos después de un elemento existente (schedule_pay) -->
            <xpath expr="//field[@name='schedule_pay']" position="after">
                <field name="payroll_xlsx_binary" filename="payroll_xlsx_file_name" readonly="1"/>
                <field name="is_christmas_salary" readonly="1"/>
            </xpath>

            <!-- Agregar header si no existe -->
            <xpath expr="//form" position="inside">
                <header>
                    <button name="action_mail_send" type="object" class="oe_highlight" string="Enviar recibos"/>
                    <button name="generate_payroll_xlsx" type="object" string="Generar archivo" class="oe_highlight"/>
                    <button name="assign_worked_hours" type="object" string="Asignar horas" class="oe_highlight"/>
                    <button name="compute_all_payslips" type="object" string="Calcular todos" class="oe_highlight"/>
                    <button name="confirm_all_payslips" type="object" string="Confirmar todos" class="oe_highlight" style="position:relative; left:150px;"/>
                </header>
            </xpath>

            <!-- Listado de recibos dentro de un nuevo grupo debajo del existente -->
            <xpath expr="//form/group[last()]" position="after">
                <group>
                    <field name="slip_ids">
                        <list editable="bottom">
                            <field name="employee_id" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="real_worked_hours" string="Horas trabajadas"/>
                            <field name="total_to_pay" string="Total a Pagar"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
    <!-- Eliminado: el wizard hr.payslip.employees no existe en esta versión -->
</odoo>
