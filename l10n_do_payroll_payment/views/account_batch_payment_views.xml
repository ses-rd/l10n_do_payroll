<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_payment_form_payroll_txt" model="ir.ui.view">
        <field name="name">account.batch.payment.form.payroll.txt</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="TXT Banco" name="payroll_bank_txt">
                    <group>
                        <group>
                            <field name="payroll_payslip_run_id" readonly="1"/>
                            <field name="journal_id" readonly="1"/>
                            <field name="payroll_bank_type" readonly="1"/>
                            <field name="payroll_effective_date"/>
                            <field name="payroll_sequence" readonly="1"/>
                            <field name="payroll_other_bank_sequence" readonly="1" invisible="not payroll_other_bank_sequence"/>
                        </group>
                        <group>
                            <field name="payroll_origin_email" readonly="1"/>
                            <field name="payroll_origin_company_bank_code" readonly="1"/>
                            <field name="payroll_description"/>
                            <field name="payroll_txt_file" filename="payroll_txt_filename" readonly="1" string="TXT mismo banco" invisible="not payroll_txt_file"/>
                            <field name="payroll_txt_filename" readonly="1" invisible="not payroll_txt_filename"/>
                            <field name="payroll_other_bank_txt_file" filename="payroll_other_bank_txt_filename" readonly="1" string="TXT otros bancos" invisible="not payroll_other_bank_txt_file"/>
                            <field name="payroll_other_bank_txt_filename" readonly="1" invisible="not payroll_other_bank_txt_filename"/>
                        </group>
                    </group>
                    <group>
                        <button name="action_generate_payroll_bank_txt" type="object" string="Generar TXT Banco" class="oe_highlight"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
